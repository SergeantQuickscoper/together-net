<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020202"
    tools:context=".NetworkScreenActivity">

    <Button
        android:id="@+id/btnMessageInbox"
        android:layout_width="201dp"
        android:layout_height="43dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/button_background_blue"
        android:backgroundTint="@null"
        android:fontFamily="@font/msxscreen01"
        android:gravity="center"
        android:stateListAnimator="@null"
        android:text="My Inbox"
        android:textAlignment="center"
        android:textColor="#2C1DFF"
        android:textColorHighlight="#FF52F3"
        android:textColorHint="#FF52F3"
        android:textColorLink="#FF52F3"
        android:textSize="20sp"
        android:translationY="5dp"
        app:iconTint="@color/design_default_color_primary"
        app:layout_constraintBottom_toTopOf="@+id/btnSettings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnSendMessage"
        android:layout_width="201dp"
        android:layout_height="43dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/button_background_blue"
        android:backgroundTint="@null"
        android:fontFamily="@font/msxscreen01"
        android:gravity="center"
        android:stateListAnimator="@null"
        android:text="Start Chat"
        android:textAlignment="center"
        android:textColor="#2C1DFF"
        android:textColorHighlight="#FF52F3"
        android:textColorHint="#FF52F3"
        android:textColorLink="#FF52F3"
        android:textSize="20sp"
        android:translationY="5dp"
        app:iconTint="@color/design_default_color_primary"
        app:layout_constraintBottom_toTopOf="@+id/btnMessageInbox"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="201dp"
        android:layout_height="43dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/button_background"
        android:backgroundTint="@null"
        android:fontFamily="@font/msxscreen01"
        android:gravity="center"
        android:stateListAnimator="@null"
        android:text="Settings"
        android:textAlignment="center"
        android:textColor="#FF52F3"
        android:textColorHighlight="#FF52F3"
        android:textColorHint="#FF52F3"
        android:textColorLink="#FF52F3"
        android:textSize="20sp"
        android:translationY="5dp"
        app:iconTint="@color/design_default_color_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pet"
        android:text="TogetherNet"
        android:textColor="#49FF40"
        android:textSize="34sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.059" />

    <TextView
        android:id="@+id/status"
        android:layout_width="104dp"
        android:layout_height="15dp"
        android:layout_marginStart="96dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/pet"
        android:text="Status: "
        android:textColor="#FF52F3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="222dp"
        android:layout_height="15dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/pet"
        android:text="Network Stats:"
        android:textColor="#FF52F3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="263dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="56dp"
        android:fontFamily="@font/pet"
        android:text="Discovered Nodes: "
        android:textColor="#FFF71F"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status" />

    <TextView
        android:id="@+id/totalDiscoveredNodesText"
        android:layout_width="15dp"
        android:layout_height="17dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="56dp"
        android:fontFamily="@font/pet"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/textView5"
        app:layout_constraintTop_toBottomOf="@+id/statusText" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="115dp"
        android:layout_height="17dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="88dp"
        android:fontFamily="@font/pet"
        android:text="Offline"
        android:textColor="#E91E1E"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/status"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

</androidx.constraintlayout.widget.ConstraintLayout>