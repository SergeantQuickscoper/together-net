<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060606"
    tools:context=".ChatActivity">

    <!-- Header with back arrow and chat title -->

    <!-- Messages area -->

    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_arrow_back_green"
        app:layout_constraintBottom_toBottomOf="@+id/chat_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.727"
        app:tint="#49FF40" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@+id/chat_title"
        app:layout_constraintBottom_toTopOf="@+id/message_input_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!-- Input Bar at Bottom -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/message_input_layout"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/button_background"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/message_input"
            android:layout_width="301dp"
            android:layout_height="45dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/input_background"
            android:fontFamily="@font/msxscreen01"
            android:hint="Enter a message...."
            android:padding="10dp"
            android:textColor="#FF52F3"
            android:textColorHint="#FF52F3"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/send_button"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.571" />

        <ImageButton
            android:id="@+id/send_button"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_background"
            android:contentDescription="Send"
            android:src="@drawable/ic_send_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.571"
            app:tint="#49FF40" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/chat_title"
        android:layout_width="275dp"
        android:layout_height="57dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/pet"
        android:text="Chatting with:"
        android:textAlignment="center"
        android:textColor="#49FF40"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/texting_with"
        android:layout_width="256dp"
        android:layout_height="30dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/msxscreen01"
        android:gravity="center"
        android:text="TextView"
        android:textAlignment="center"
        android:textColor="#291AFB"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/chat_title"
        app:layout_constraintEnd_toEndOf="@+id/chat_title"
        app:layout_constraintStart_toStartOf="@+id/chat_title" />

</androidx.constraintlayout.widget.ConstraintLayout>